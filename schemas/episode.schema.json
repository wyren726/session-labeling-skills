{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "episode-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "session_id",
    "source_snapshot_id",
    "boundary",
    "goal",
    "requirements",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "episode-v1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_turn_id",
        "end_turn_id",
        "turn_ids",
        "boundary_confidence",
        "source_window",
        "candidate_windows",
        "reconciliation"
      ],
      "properties": {
        "start_turn_id": {
          "type": "string",
          "minLength": 1
        },
        "end_turn_id": {
          "type": "string",
          "minLength": 1
        },
        "turn_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundary_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "source_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window_index",
            "first_turn_id",
            "last_turn_id"
          ],
          "properties": {
            "window_index": {
              "type": "integer",
              "minimum": 0
            },
            "first_turn_id": {
              "type": "string"
            },
            "last_turn_id": {
              "type": "string"
            }
          }
        },
        "candidate_windows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "window_index",
              "first_turn_id",
              "last_turn_id"
            ],
            "properties": {
              "window_index": {
                "type": "integer",
                "minimum": 0
              },
              "first_turn_id": {
                "type": "string"
              },
              "last_turn_id": {
                "type": "string"
              }
            }
          }
        },
        "reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "candidate_count",
            "method"
          ],
          "properties": {
            "status": {
              "enum": [
                "single_window",
                "duplicate_merged",
                "model_reconciled",
                "unresolved"
              ]
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "origin_event_ids"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "origin_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "text",
          "origin_event_ids",
          "is_core"
        ],
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "origin_event_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "is_core": {
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_skill",
        "producer_version",
        "method",
        "source_snapshot_id"
      ],
      "properties": {
        "producer_skill": {
          "type": "string"
        },
        "producer_version": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "source_snapshot_id": {
          "type": "string"
        }
      }
    }
  }
}
