{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-checkpoint-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signature",
    "source_snapshot_id",
    "status",
    "episodes",
    "model_metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-checkpoint-v1"
    },
    "signature": {
      "type": "string"
    },
    "source_snapshot_id": {
      "type": "string"
    },
    "status": {
      "const": "understanding_complete"
    },
    "episodes": {
      "type": "array"
    },
    "model_metadata": {
      "type": "array"
    }
  }
}
